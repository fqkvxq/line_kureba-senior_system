# ------------------------------------------------------------------------------
# アップファーレン / シニア向けLINE管理システム ルート設定 (.htaccess)
# サブディレクトリ配置（/line_system/等）およびドメイン直下の両方で
# URLから /public_html/ を透過させ、直接アクセス可能にする設定
# ------------------------------------------------------------------------------
DirectoryIndex index.php index.html

SetEnv TZ Asia/Tokyo

<IfModule mod_php7.c>
    php_value date.timezone "Asia/Tokyo"
</IfModule>
<IfModule mod_php8.c>
    php_value date.timezone "Asia/Tokyo"
</IfModule>
<IfModule mod_php.c>
    php_value date.timezone "Asia/Tokyo"
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # FastCGI / Xserver環境向け: HTTP認証ヘッダーおよびカスタムヘッダー転送設定
    RewriteCond %{HTTP:Authorization} ^(.*)
    RewriteRule .* - [e=HTTP_AUTHORIZATION:%1]
    RewriteCond %{HTTP:X-Admin-Password} ^(.*)
    RewriteRule .* - [e=HTTP_X_ADMIN_PASSWORD:%1]
    RewriteCond %{HTTP:X-Line-Account} ^(.*)
    RewriteRule .* - [e=HTTP_X_LINE_ACCOUNT:%1]
    RewriteCond %{HTTP:X-Line-Signature} ^(.*)
    RewriteRule .* - [e=HTTP_X_LINE_SIGNATURE:%1]

    # すでに public_html 配下へのリライト済みの場合は何もしない (再帰ループ AH00124 防止)
    RewriteCond %{ENV:REDIRECT_STATUS} 200
    RewriteRule .* - [L]

    # 1. ルート直下へのアクセスは index.php に委譲
    RewriteRule ^$ index.php [L]

    # 2. 内部的にすべてのリクエストを public_html/ 配下のファイル・ディレクトリへ透過転送
    RewriteCond %{REQUEST_URI} !/public_html/
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{DOCUMENT_ROOT}%{REQUEST_URI}/public_html/$1 -f [OR]
    RewriteCond %{DOCUMENT_ROOT}%{REQUEST_URI}/public_html/$1 -d [OR]
    RewriteCond public_html/$1 -f [OR]
    RewriteCond public_html/$1 -d
    RewriteRule ^(.*)$ public_html/$1 [L]
</IfModule>

<IfModule mod_setenvif.c>
    SetEnvIfNoCase Authorization "(.*)" HTTP_AUTHORIZATION=$1
    SetEnvIfNoCase X-Admin-Password "(.*)" HTTP_X_ADMIN_PASSWORD=$1
    SetEnvIfNoCase X-Line-Account "(.*)" HTTP_X_LINE_ACCOUNT=$1
    SetEnvIfNoCase X-Line-Signature "(.*)" HTTP_X_LINE_SIGNATURE=$1
</IfModule>
