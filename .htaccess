# ------------------------------------------------------------------------------
# アップファーレン / シニア向けLINE管理システム ルート設定 (.htaccess)
# サブディレクトリ配置（/line_kureba-senior_system/等）およびドメイン直下の両方で
# URLから /public_html/ を完全除去し、直接アクセス可能にする設定
# ------------------------------------------------------------------------------
SetEnv TZ Asia/Tokyo

<IfModule mod_php7.c>
    php_value date.timezone "Asia/Tokyo"
</IfModule>
<IfModule mod_php8.c>
    php_value date.timezone "Asia/Tokyo"
</IfModule>
<IfModule mod_php.c>
    php_value date.timezone "Asia/Tokyo"
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # FastCGI / Xserver環境向け: HTTP認証ヘッダーおよびカスタムヘッダー転送設定
    RewriteCond %{HTTP:Authorization} ^(.*)
    RewriteRule .* - [e=HTTP_AUTHORIZATION:%1]
    RewriteCond %{HTTP:X-Admin-Password} ^(.*)
    RewriteRule .* - [e=HTTP_X_ADMIN_PASSWORD:%1]
    RewriteCond %{HTTP:X-Line-Account} ^(.*)
    RewriteRule .* - [e=HTTP_X_LINE_ACCOUNT:%1]

    # 1. ブラウザから直接 /public_html/... にアクセスされた場合は URL から /public_html を外して301リダイレクト
    # ※POSTリクエストおよびwebhook/APIエンドポイントはリダイレクトせずに直接実行（LINE Webhookの消失防止）
    RewriteCond %{REQUEST_METHOD} !=POST
    RewriteCond %{THE_REQUEST} \s+(\S*?)/public_html/([^\s?]*) [NC]
    RewriteCond %{REQUEST_URI} !/(webhook\.php|api\.php|redirect\.php|setup\.php)
    RewriteRule ^ %1/%2 [R=301,L,NE]

    # 2. ディレクトリ直下（/）へのアクセスは管理画面（admin/）へ
    RewriteRule ^$ public_html/admin/index.html [L]

    # 3. 内部的にすべてのリクエストを public_html/ 配下のファイル・ディレクトリへ転送
    RewriteCond %{REQUEST_URI} !public_html
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ public_html/$1 [L]
</IfModule>

<IfModule mod_setenvif.c>
    SetEnvIfNoCase Authorization "(.*)" HTTP_AUTHORIZATION=$1
    SetEnvIfNoCase X-Admin-Password "(.*)" HTTP_X_ADMIN_PASSWORD=$1
    SetEnvIfNoCase X-Line-Account "(.*)" HTTP_X_LINE_ACCOUNT=$1
</IfModule>
