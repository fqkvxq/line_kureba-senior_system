# ------------------------------------------------------------------------------
# アップファーレン サーバー設定 (public_html/.htaccess)
# タイムゾーンを日本時間(JST / Asia/Tokyo)に設定
# ------------------------------------------------------------------------------
SetEnv TZ Asia/Tokyo

<IfModule mod_php7.c>
    php_value date.timezone "Asia/Tokyo"
</IfModule>
<IfModule mod_php8.c>
    php_value date.timezone "Asia/Tokyo"
</IfModule>
<IfModule mod_php.c>
    php_value date.timezone "Asia/Tokyo"
</IfModule>

# ------------------------------------------------------------------------------
# FastCGI / Xserver / WordPress同居環境: ヘッダー確実転送 & リライト干渉防止
# ------------------------------------------------------------------------------
<IfModule mod_rewrite.c>
    RewriteEngine On

    # 1. FastCGI / Xserver環境向け: HTTP認証ヘッダーおよびLINE署名ヘッダー転送設定（最優先実行）
    RewriteCond %{HTTP:Authorization} ^(.*)
    RewriteRule .* - [e=HTTP_AUTHORIZATION:%1]
    RewriteCond %{HTTP:X-Admin-Password} ^(.*)
    RewriteRule .* - [e=HTTP_X_ADMIN_PASSWORD:%1]
    RewriteCond %{HTTP:X-Line-Account} ^(.*)
    RewriteRule .* - [e=HTTP_X_LINE_ACCOUNT:%1]
    RewriteCond %{HTTP:X-Line-Signature} ^(.*)
    RewriteRule .* - [e=HTTP_X_LINE_SIGNATURE:%1]

    # 2. 親ディレクトリ(WordPress等)のリライト干渉を防ぎ、実在ファイルを即座に確定処理
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]
</IfModule>

<IfModule mod_setenvif.c>
    SetEnvIfNoCase Authorization "(.*)" HTTP_AUTHORIZATION=$1
    SetEnvIfNoCase X-Admin-Password "(.*)" HTTP_X_ADMIN_PASSWORD=$1
    SetEnvIfNoCase X-Line-Account "(.*)" HTTP_X_LINE_ACCOUNT=$1
    SetEnvIfNoCase X-Line-Signature "(.*)" HTTP_X_LINE_SIGNATURE=$1
</IfModule>
